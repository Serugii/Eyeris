<body class="min-h-screen bg-gray-100 text-gray-900">
  <div class="max-w-md mx-auto mt-10 bg-white p-8 rounded shadow min-h-[600px] flex flex-col justify-between">
    <div class="text-xl font-bold text-center mb-4 hover:underline"><%= link_to 'Eyeris', root_path %></div>

    <div>
      <h2 class="text-3xl text-green-600 font-bold mb-6 text-center">
        <%= t("devise.registrations.edit.title", default: "Редагування профілю") %>
      </h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-4">
          <%= f.label :email, t("label.user.email"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-green-500 focus:border-green-500" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="mb-4 text-sm text-yellow-600">
            <%= t("devise.registrations.edit.pending_reconfirmation", default: "Очікується підтвердження нової адреси:") %> <%= resource.unconfirmed_email %>
          </div>
        <% end %>

        <div class="mb-4">
          <%= f.label :password, t("label.user.password"), class: "block text-sm font-medium text-gray-700" %>
          <p class="text-xs text-gray-500 mb-1">
            (<%= t("devise.registrations.edit.leave_blank", default: "залиште порожнім, якщо не хочете змінювати") %>)
          </p>
          <%= f.password_field :password, autocomplete: "new-password",
              class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-green-500 focus:border-green-500" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-500 mt-1">
              (<%= t("devise.registrations.new.password_minimum", count: @minimum_password_length, default: "%{count} символів мінімум") %>)
            </p>
          <% end %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, t("label.user.password_confirmation"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-green-500 focus:border-green-500" %>
        </div>

        <div class="mb-6">
          <%= f.label :current_password, t("devise.registrations.edit.current_password", default: "Поточний пароль"), class: "block text-sm font-medium text-gray-700" %>
          <p class="text-xs text-gray-500 mb-1">
            (<%= t("devise.registrations.edit.current_password_hint", default: "потрібен для підтвердження змін") %>)
          </p>
          <%= f.password_field :current_password, autocomplete: "current-password",
              class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-green-500 focus:border-green-500" %>
        </div>

        <div>
          <%= f.submit t("devise.registrations.edit.submit", default: "Оновити профіль"),
              class: "w-full bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded font-semibold" %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 border-t pt-4 text-center">
      <h3 class="text-sm font-medium text-red-700 mb-2"><%= t("devise.registrations.edit.cancel_title", default: "Скасувати обліковий запис") %></h3>
      <div>
        <%= button_to t("devise.registrations.edit.cancel_account", default: "Видалити обліковий запис"),
            registration_path(resource_name),
            data: { confirm: t("devise.registrations.edit.cancel_confirm", default: "Ви впевнені?") },
            method: :delete,
            class: "text-red-600 hover:underline text-sm" %>
      </div>
    </div>

    <div class="text-center mt-4">
      <%= link_to t("devise.shared.links.back", default: "Назад"), root_path, class: "text-green-600 hover:underline text-sm" %>
    </div>
  </div>
</body>
