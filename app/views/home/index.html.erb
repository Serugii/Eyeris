<body class="min-h-screen bg-gray-100 text-gray-900">
  <nav class="bg-white shadow p-4 flex justify-between items-center min-h-[64px]">
    <div class="text-xl font-bold">Eyeris</div>
    <div class="flex items-center space-x-4">
      <% if user_signed_in? %>
        <span class="text-sm text-gray-800"><%= current_user.email %></span>
        <% if user_signed_in? %>
        <%= link_to "Профіль", profile_path,
              class: "bg-purple-500 hover:bg-purple-600 text-white font-semibold py-2 px-4 rounded transition" %>
        <% end %>
        <%= button_to "Вийти", destroy_user_session_path, method: :delete,
              class: "bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded transition" %>
      <% else %>
        <%= link_to "Увійти", new_user_session_path,
              class: "bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded transition" %>
        <%= link_to "Реєстрація", new_user_registration_path,
              class: "bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-4 rounded transition" %>
      <% end %>
    </div>
  </nav>
  <% if flash[:alert] %>
    <div id="flash-alert" class="relative mx-4 my-3 rounded-md border border-red-400 bg-red-100 px-4 py-3 text-red-700">
      <span><%= flash[:alert] %></span>
      <button onclick="document.getElementById('flash-alert').style.display='none'" class="absolute top-2 right-2 text-xl font-semibold leading-none text-red-700 hover:text-red-900 focus:outline-none">
        &times;
      </button>
    </div>
  <% end %>
  <main class="max-w-4xl mx-auto p-6">
    <%= yield %>
  </main>
</body>