<main class="max-w-4xl mx-auto p-6">
  <div class="bg-white rounded-xl shadow-lg p-8 text-center">
    <p class="text-lg text-gray-700 mb-6">
      Це сторінка доступних тестів та вправ. Ви тут можете перевірити свій зір або обрати вправи для очей.
    </p>
    <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4">Тести для перевірки зору</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <% tests = [
            { path: vision_sharpness_tests_path, image: "sharpness.png", label: "Тест на гостроту зору" },
            { path: color_blindness_tests_path, image: "blind.png", label: "Тест на дальтонізм" },
            { path: duochrome_test_path, image: "duochrome.png", label: "Дуохромний тест" },
            { path: syvtsevs_table_test_path, image: "syvtsevIcon.png", label: "Таблиця Сивцева" }
          ] %>

          <% tests.each do |test| %>
            <%= link_to test[:path], class: "flex flex-col items-center bg-emerald-100 hover:bg-emerald-200 text-gray-800 font-semibold p-4 rounded-lg shadow transition space-y-3" do %>
              <%= image_tag "tests/#{test[:image]}", alt: test[:label], class: "max-w-[120px] h-auto object-contain border border-emerald-300 rounded shadow-sm" %>
              <span><%= test[:label] %></span>
            <% end %>
          <% end %>
        </div>
    </div>
    <br>
    <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4">Вправи для очей</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <% exercises = [
            { path: relaxation_exercises_path, image: "relaxion.png", label: "Вправи для відпочинку" },
            { path: recovery_exercises_path, image: "recovery.png", label: "Вправи для відновлення зору" }
          ] %>
          <% exercises.each do |exercise| %>
            <%= link_to exercise[:path], class: "flex flex-col items-center bg-emerald-100 hover:bg-emerald-200 text-gray-800 font-semibold p-4 rounded-lg shadow transition space-y-3" do %>
              <%= image_tag "tests/#{exercise[:image]}", alt: exercise[:label], class: "max-w-[120px] h-auto object-contain border border-emerald-300 rounded shadow-sm" %>
              <span><%= exercise[:label] %></span>
            <% end %>
          <% end %>
        </div>
    </div>
  </div>
</main>