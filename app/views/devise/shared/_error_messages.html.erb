<% if resource.errors.any? %>
  <div id="error_explanation" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
    <strong class="font-bold">Помилка:</strong>
    <ul class="list-disc list-inside mt-2">
      <% resource.errors.messages.each do |attribute, messages| %>
        <% messages.uniq.each do |message| %>
          <li><%= message.capitalize %></li>
        <% end %>
      <% end %>
    </ul>
  </div>
<% end %>
