<h2 class="text-2xl font-bold text-center text-gray-800 mb-6">Повторне надсилання інструкцій для розблокування</h2>

<%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "max-w-md mx-auto bg-white p-6 rounded-lg shadow-md" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="mb-4">
    <%= f.label :email, "Електронна пошта", class: "block text-gray-700 font-medium mb-1" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="text-center">
    <%= f.submit "Надіслати інструкції ще раз", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md" %>
  </div>
<% end %>

<div class="text-center mt-4">
  <%= render "devise/shared/links" %>
</div>
