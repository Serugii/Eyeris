<main class="max-w-4xl mx-auto p-6 space-y-6 rounded">
  <div class="bg-white rounded shadow-xl p-8 mx-auto min-h-[630px]">
    <div id="step-1">
      <h1 class="text-2xl font-semibold text-gray-800 text-center">Дуохромний тест</h1>
      <div class="space-y-4 pl-4">
        <p class="text-gray-700">
          <strong>Дуохромний тест</strong> – це один із найпоширеніших методів перевірки зору для визначення короткозорості 
          та далекозорості. Для проведення тесту використовуються таблиці з чорними знаками (буквами, цифрами або кільцями), 
          розташованими на червоному або зеленому тлі.
        </p>
        <h2 class="text-lg font-semibold text-gray-800 mt-6 text-center">Вимоги до тесту</h2>
        <ul class="list-disc pl-6 text-gray-700 space-y-1 pt-4 pb-4">
          <li>Проходьте тест, коли почуваєтеся добре (не втомлені, не під впливом ліків або алкоголю).</li>
          <li>Забезпечте достатнє освітлення в кімнаті.</li>
          <li>Не нахиляйте голову та не кліпайте очима під час проходження тесту.</li>
          <li>Одне око закрийте долонею, не заплющуйте.</li>
          <li>Відстань до екрану повинна бути приблизно 1 метр.</li>
        </ul>
      </div>
      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 text-yellow-800 text-sm mt-6 text-center">
        Цей тест не замінює професійну діагностику. Зверніться до офтальмолога для точного результату.
      </div>
      <div class="text-center pt-4">
        <button onclick="showStep(2)" class="bg-orange-400 hover:bg-orange-500 text-white font-semibold py-3 
        px-6 rounded-lg shadow-md transition">Почати тестування</button>
      </div>
    </div>
    <div id="step-2" class="hidden">
      <h2 class="text-xl font-semibold text-gray-800 text-center">Оцінка для правого ока</h2>
      <%= image_tag "tests/duotest.png", alt: "Дуохромний тест", class: "w-[500px] rounded border shadow mt-6 mx-auto" %>
      <div class="text-center pt-4"><p>Прикрийте долонею ліве око. Сфокусуйтеся та оберіть один з поданих варіантів.</p></div>
      <div class="flex flex-wrap justify-center gap-4 mt-6">
        <div>
          <button onclick="setAnswer('right', 'red')" data-eye="right" data-value="red"
            class="bg-amber-200 text-gray-800 font-semibold py-3 px-4 rounded-lg shadow transition">
            Чіткіше на червоному
          </button>
        </div>
        <div>
          <button onclick="setAnswer('right', 'equal')" data-eye="right" data-value="equal"
            class="bg-amber-200 text-gray-800 font-semibold py-3 px-4 rounded-lg shadow transition">
            Однаково
          </button>
        </div>
        <div>
          <button onclick="setAnswer('right', 'green')" data-eye="right" data-value="green"
            class="bg-amber-200 text-gray-800 font-semibold py-3 px-4 rounded-lg shadow transition">
            Чіткіше на зеленому
          </button>
        </div>
      </div>
      <div class="text-center mt-6">
        <button onclick="validateAndProceed(2, 'right', 3)" 
          class="bg-orange-400 hover:bg-orange-500 text-white font-semibold py-3 px-6 rounded-lg shadow-md transition">
          Далі
        </button>
      </div>
      <div class="validation-error hidden text-red-600 font-semibold text-center mt-4">
        Будь ласка, оберіть варіант для правого ока.
      </div>
    </div>
    <div id="step-3" class="hidden">
      <h2 class="text-xl font-semibold text-gray-800 text-center">Оцінка для лівого ока</h2>
      <%= image_tag "tests/duotest.png", alt: "Дуохромний тест", class: "w-[500px] rounded border shadow mt-6 mx-auto" %>
      <div class="text-center pt-4"><p>Прикрийте долонею праве око. Сфокусуйтеся та оберіть один з поданих варіантів.</p></div>
      <div class="flex flex-wrap justify-center gap-4 mt-6">
        <div>
          <button onclick="setAnswer('left', 'red')" data-eye="left" data-value="red"
            class="bg-amber-200 text-gray-800 font-semibold py-3 px-4 rounded-lg shadow transition">
            Чіткіше на червоному
          </button>
        </div>
        <div>
          <button onclick="setAnswer('left', 'equal')" data-eye="left" data-value="equal"
            class="bg-amber-200 text-gray-800 font-semibold py-3 px-4 rounded-lg shadow transition">
            Однаково
          </button>
        </div>
        <div>
          <button onclick="setAnswer('left', 'green')" data-eye="left" data-value="green"
            class="bg-amber-200 text-gray-800 font-semibold py-3 px-4 rounded-lg shadow transition">
            Чіткіше на зеленому
          </button>
        </div>
      </div>
      <div class="text-center mt-6">
        <button onclick="showResult()" 
          class="bg-orange-400 hover:bg-orange-500 text-white font-semibold py-3 px-6 rounded-lg shadow-md transition">
          Показати результат
        </button>
      </div>
      <div class="validation-error hidden text-red-600 font-semibold text-center mt-6">
        Будь ласка, оберіть варіант для лівого ока.
      </div>
    </div>
    <div id="step-4" class="hidden">
      <h2 class="text-2xl font-semibold text-gray-800 text-center">Результат тестування</h2>
      <%= image_tag "tests/result.png", alt: "Результат", class: "max-w-[120px] mx-auto mt-4"%>
      <div id="result-text" class="text-gray-700 mt-6 text-base text-left max-w-2xl mx-auto"></div>
      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 text-yellow-800 text-sm mt-4 text-center">
        <strong>Зверніть увагу:</strong> Цей тест є орієнтовним. Для професійної діагностики рекомендуємо звернутися до офтальмолога.
      </div>
      <div class="text-center mt-6 space-y-4">
        <button onclick="restartTest()" 
          class="inline-block bg-amber-200 hover:bg-amber-300 text-gray-800 font-semibold py-3 px-6 rounded-lg shadow transition">
          Спробувати знову
        </button>
        <%= link_to "Повернутись до вправ", dashboard_path,
          class: "inline-block bg-orange-400 hover:bg-orange-500 text-white font-semibold py-3 px-6 rounded-lg shadow transition" %>
      </div>
    </div>
  </div>
</main>
<script>
  var answers = { right: null, left: null };
  function showStep(step) {
    for (let i = 1; i <= 4; i++) {
      document.getElementById(`step-${i}`).classList.add('hidden');
    }
    document.getElementById(`step-${step}`).classList.remove('hidden');
  }
  function setAnswer(eye, value) {
    answers[eye] = value;
    document.querySelectorAll(`[data-eye="${eye}"]`).forEach(btn => {
      btn.classList.remove('bg-emerald-400', 'text-white');
      btn.classList.add('bg-amber-200', 'text-gray-800');
    });
    const selectedBtn = document.querySelector(`[data-eye="${eye}"][data-value="${value}"]`);
    if (selectedBtn) {
      selectedBtn.classList.remove('bg-amber-200', 'text-gray-800');
      selectedBtn.classList.add('bg-emerald-400', 'text-white');
    }
    const errorBox = document.querySelector(`#step-${eye === 'right' ? 2 : 3} .validation-error`);
    if (errorBox) {
      errorBox.classList.add("hidden");
    }
  }
  function validateAndProceed(currentStep, eye, nextStep) {
    const errorBox = document.querySelector(`#step-${currentStep} .validation-error`);
    if (!answers[eye]) {
      errorBox.classList.remove("hidden");
      return;
    } else {
      errorBox.classList.add("hidden");
      showStep(nextStep);
    }
  }
  function showResult() {
    const errorBox = document.querySelector(`#step-3 .validation-error`);
    if (!answers.left) {
      errorBox.classList.remove("hidden");
      return;
    } else {
      errorBox.classList.add("hidden");
    }
    function explainEye(title, value) {
      switch (value) {
        case "red":
          return `<div><strong>${title}:</strong> Літери чіткіші на <span class="text-red-600 font-semibold">червоному фоні</span>. 
            Це може свідчити про <strong>короткозорість</strong> (міопію).</div>`;
        case "green":
          return `<div><strong>${title}:</strong> Літери чіткіші на <span class="text-green-600 font-semibold">зеленому фоні</span>. 
            Це може свідчити про <strong>далекозорість</strong> (гіперметропію).</div>`;
        case "equal":
          return `<div><strong>${title}:</strong> Літери видно однаково на обох фонах. 
            Це може означати <strong>нормальний зір</strong>.</div>`;
        default:
          return `<div><strong>${title}:</strong> Результат не визначено.</div>`;
      }
    }

    const resultText = [
      explainEye("Праве око", answers.right),
      explainEye("Ліве око", answers.left)
    ].join("<br>");

    document.getElementById("result-text").innerHTML = resultText;
    showStep(4);
  }
  function interpret(value) {
    switch (value) {
      case "red": return "бачите краще на червоному — можлива короткозорість.";
      case "green": return "бачите краще на зеленому — можлива далекозорість.";
      case "equal": return "бачите однаково — зорове сприйняття в нормі.";
      default: return "немає даних.";
    }
  }
  function restartTest() {
    answers = { right: null, left: null };
    document.querySelectorAll('[data-eye]').forEach(btn => {
      btn.classList.remove('bg-emerald-400', 'text-white');
      btn.classList.add('bg-amber-200', 'text-gray-800');
    });
    document.querySelectorAll('.validation-error').forEach(el => {
      el.classList.add('hidden');
    });
    document.getElementById('result-text').innerHTML = "";
    showStep(1);
  }
</script>
